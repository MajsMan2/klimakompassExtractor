{
  "name": "klimakompasset-extractor",
  "version": "1.0.0",
  "private": true,
  "description": "Traekker data ud af Klimakompasset-excelfilen (Data (alle poster) og Data (E-noegletal)) og pusher det til Bubble.io via Data API'et.",
  "type": "module",
  "main": "src/index.js",
  "scripts": {
    "start": "node src/index.js",
    "test:generate-sample": "node test/generate-sample.mjs",
    "test:local": "node test/generate-sample.mjs && node src/index.js --local-file test/sample.xlsx --dry-run"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "xlsx": "^0.18.5"
  }
}
