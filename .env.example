# Kopiér denne fil til ".env" og udfyld til lokal test.
# I produktion (GitHub Actions) sættes de samme navne som repo-secrets i
# stedet — se README.md.

# --- Paakraevet ---
BUBBLE_API_ROOT=https://dit-app-navn.bubbleapps.io/api/1.1/obj
# Brug .../version-test/api/1.1/obj i stedet, hvis du vil teste mod
# Bubbles udviklings-version fremfor den live app.

BUBBLE_API_TOKEN=din-bubble-private-key

BUBBLE_ALLE_POSTER_TYPE=climate_alle_poster
BUBBLE_ENOEGLETAL_TYPE=climate_e_noegletal

# --- Valgfrit: status-tilbagemelding ---
# Navnet på en Bubble Data Type med felterne:
#   status (text), message (text), rows_alle_poster (number), rows_e_noegletal (number)
# Lad stå tom for at springe status-opdatering over.
BUBBLE_STATUS_TYPE=

# --- Kun til lokal test ---
# Sættes normalt via --local-file og --dry-run flagene i stedet, se README.
# FILE_URL=
# UPLOAD_ID=
# USER_ID=
# COMPANY_ID=
# YEAR_ID=
# DRY_RUN=false
